# Flux Bot 运行配置（复制为 .env 后按需修改）
# 只有 FLUX_AUTH_TOKEN 与模型密钥是必填，其余留默认即可。

# --- 鉴权 ---
# 必填：不设置时 Bot 节点只接受本机回环直连，其他来源一律 401。
# 注意：经 Docker 发布端口进来的请求来自 docker 网关，不是回环；没有令牌会被拒绝。
# 公网 / 局域网 / 跨机反向代理部署必须设置（生成：python -c "import secrets;print(secrets.token_urlsafe(32))"）。
FLUX_AUTH_TOKEN=

# 宿主机端口绑定地址（docker-compose 使用）。默认 127.0.0.1，仅同机反向代理 / 本机可用。
# 只有反向代理在另一台机器 / 需要局域网直连时才改为 0.0.0.0——此时 FLUX_AUTH_TOKEN 必填。
# FLUX_BIND_ADDR=127.0.0.1

# 未设置 FLUX_AUTH_TOKEN 时的显式开放开关。仅在完全可信的内网使用；
# 设为 true 等于所有能访问端口的人都能创建 Bot / 触发任务，启动时会打印 WARNING。
# 公网部署请保持注释（默认 fail-closed：只放行回环直连）。
# FLUX_ALLOW_NO_AUTH=true

# --- 手机设备配对 ---
# 配对成功后签发的设备令牌有效期（天）；0 = 永不过期。
FLUX_DEVICE_TOKEN_TTL_DAYS=90
# 一次性配对码有效期（秒）。
FLUX_PAIRING_CODE_TTL_SECONDS=600

# --- 云桌面（Bot 桌面 / Hermes 云电脑）---
# 两个接口共用同一份地址解析：
#   GET  /api/v1/desktop                       入口参数（公开隧道地址 + 可选长期凭据）
#   POST /api/v1/bots/{bot_id}/desktop/session 按 Bot 隔离的短期 HMAC 票据
# 隧道地址优先读公开的 desktop.json（FLUX_DESKTOP_CONFIG_URL，缓存 60 秒），
# 读不到时用下面的环境变量兜底；凭据只从环境变量读取，不写进客户端源码。
#
# 地址 / 令牌的兼容别名（同一事实；主用字段优先，空白视为未设置）：
#   FLUX_DESKTOP_HOST          = FLUX_DESKTOP_GATEWAY
#   FLUX_DESKTOP_BRIDGE        = FLUX_DESKTOP_BRIDGE_URL
#   FLUX_DESKTOP_GATEWAY_TOKEN = FLUX_DESKTOP_TOKEN
# 网桥密钥只有 FLUX_DESKTOP_BRIDGE_KEY。
# FLUX_DESKTOP_HOST=
# FLUX_DESKTOP_GATEWAY_TOKEN=
# FLUX_DESKTOP_BRIDGE=
# FLUX_DESKTOP_BRIDGE_KEY=
# 票据签名密钥；留空时会话仍可用，但 ticket 为 null。配置后即使没有长期令牌，
# GET /api/v1/desktop 也会返回 configured=true（客户端改走会话接口）。
# FLUX_DESKTOP_TICKET_SECRET=
# 票据有效期（秒）。
FLUX_DESKTOP_TICKET_TTL_SECONDS=300
# true  = 会话 / 入口参数下发长期 gateway_token / bridge_key；
# false = 只下发短期票据（GET /api/v1/desktop 里的长期凭据一并置为 null）。
FLUX_DESKTOP_SEND_GATEWAY_TOKEN=true
# 公开的 desktop.json：服务端代读隧道地址；留空 = 不读，直接用环境变量兜底。
FLUX_DESKTOP_CONFIG_URL=https://flux.qiuli55.top/fluxbot-mobile/desktop.json
# desktop.json 读不到时的兜底地址（通常留空，由服务端自动发现）。
# FLUX_DESKTOP_GATEWAY=
# FLUX_DESKTOP_BRIDGE_URL=
# FLUX_DESKTOP_TOKEN=

# --- 数据库 ---
# 默认 SQLite 落 /data/flux.db，个人 NAS 足够；要多机共享再换 Postgres。
# FLUX_DATABASE_URL=postgresql+asyncpg://flux:password@postgres:5432/flux

# --- 模型 ---
# 用哪家模型由 Bot 自己的配置决定，这里只放可复用的密钥。
FLUX_DEEPSEEK_API_KEY=
# FLUX_OPENAI_API_KEY=
# FLUX_ANTHROPIC_API_KEY=

# --- Bot 调度 ---
# 开启后按 bots.next_run_at 自动开工，关掉仍可手动触发。
FLUX_BOT_SCHEDULER_ENABLED=true
FLUX_BOT_SCHEDULER_INTERVAL_SECONDS=30
# Bot 的 cron 表达式与每日 token 预算都按这个 IANA 时区解释（默认 UTC）。
# 例：Asia/Shanghai 下 `0 9 * * *` 是本地 09:00 开工，
# 每日预算也在本地零点重置（而不是 UTC 零点）。不设置时会回退到标准 TZ。
FLUX_TIMEZONE=Asia/Shanghai

# --- 飞书频道（Bot 入站 + 受审批出站）---
# 与 Supervisor 的飞书接入相互独立。回调地址：POST /api/v1/channels/feishu
# verification token 必填：未配置时拒绝一切回调（fail-closed）。
# FLUX_FEISHU_BOT_ID 是这条频道归属的 Flux Bot UUID，消息事件必须能定位到 Bot。
# 配置 Encrypt Key 后，回调必须带合法签名，密文按 AES-256-CBC 解密。
# FLUX_FEISHU_APP_ID=
# FLUX_FEISHU_APP_SECRET=
# FLUX_FEISHU_VERIFICATION_TOKEN=
# FLUX_FEISHU_ENCRYPT_KEY=
# FLUX_FEISHU_BOT_ID=
# 私有化部署可改 API 基址（默认官方）。
# FLUX_FEISHU_API_BASE=https://open.feishu.cn
# 红线：任何出站文本都要先在对话里点「允许」，拒绝 / 超时不会发送。

# --- 执行内核（DSH）---
# Bot 的每次任务都靠它推进；不开 dsh_enabled 时 Bot 只能建任务不能执行。
FLUX_DSH_ENABLED=true
# 容器里默认写 /data/dsh-home，宿主机上就是 ./data/dsh-home
# FLUX_DSH_HOME=/data/dsh-home
# DSH 注入给 Agent 的 MCP 端点（streamable-http）。端口必须与 FLUX_BOT_PORT /
# entrypoint 实际监听端口一致；不设置时 Bot 节点自动推导为
# http://127.0.0.1:${FLUX_BOT_PORT:-8600}/mcp。仅隔离实例或反向代理时才需要覆盖。
# FLUX_DSH_MCP_URL=http://127.0.0.1:8600/mcp

# --- 密钥库主密钥 ---
# 强烈建议显式设置：加密 API Key / GitHub Token 的主密钥。留空时首次启动会自动
# 生成到 $HOME/.flux/key-vault.key（容器里即 /data/home/.flux/key-vault.key）。
# 这是任意非空字符串（原始口令，不是 Fernet base64 密钥）；丢失后已存密钥无法解密。
# 生成一个随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 设置后请单独备份；不设置则务必备份上面那个 key-vault.key 文件。
# FLUX_KEY_VAULT_SECRET=

# --- 工作区 ---
# Bot 读写文件的范围，建议指向挂载进来的项目目录，不要给整个 NAS 根。
FLUX_WORKSPACE_ROOT=/data/workspace

# --- 日志 ---
FLUX_LOG_LEVEL=INFO
