# Flux Bot 运行配置（复制为 .env 后按需修改）
# 只有 FLUX_AUTH_TOKEN 与模型密钥是必填，其余留默认即可。

# --- 鉴权 ---
# 必填：不设置时 Bot 节点只接受本机回环直连，其他来源一律 401。
# 注意：经 Docker 发布端口进来的请求来自 docker 网关，不是回环；没有令牌会被拒绝。
# 公网 / 局域网 / 跨机反向代理部署必须设置（生成：python -c "import secrets;print(secrets.token_urlsafe(32))"）。
FLUX_AUTH_TOKEN=

# 宿主机端口绑定地址（docker-compose 使用）。默认 127.0.0.1，仅同机反向代理 / 本机可用。
# 只有反向代理在另一台机器 / 需要局域网直连时才改为 0.0.0.0——此时 FLUX_AUTH_TOKEN 必填。
# FLUX_BIND_ADDR=127.0.0.1

# 未设置 FLUX_AUTH_TOKEN 时的显式开放开关。仅在完全可信的内网使用；
# 设为 true 等于所有能访问端口的人都能创建 Bot / 触发任务，启动时会打印 WARNING。
# 公网部署请保持注释（默认 fail-closed：只放行回环直连）。
# FLUX_ALLOW_NO_AUTH=true

# --- 手机设备配对 ---
# 配对成功后签发的设备令牌有效期（天）；0 = 永不过期。
FLUX_DEVICE_TOKEN_TTL_DAYS=90
# 一次性配对码有效期（秒）。
FLUX_PAIRING_CODE_TTL_SECONDS=600

# --- 云桌面（Bot 桌面 / Hermes 云电脑）---
# 两个接口共用同一份地址解析：
#   GET  /api/v1/desktop                       入口参数（公开隧道地址 + 可选长期凭据）
#   POST /api/v1/bots/{bot_id}/desktop/session 按 Bot 隔离的短期 HMAC 票据
# 隧道地址优先读公开的 desktop.json（FLUX_DESKTOP_CONFIG_URL，缓存 60 秒），
# 读不到时用下面的环境变量兜底；凭据只从环境变量读取，不写进客户端源码。
#
# 地址 / 令牌的兼容别名（同一事实；主用字段优先，空白视为未设置）：
#   FLUX_DESKTOP_HOST          = FLUX_DESKTOP_GATEWAY
#   FLUX_DESKTOP_BRIDGE        = FLUX_DESKTOP_BRIDGE_URL
#   FLUX_DESKTOP_GATEWAY_TOKEN = FLUX_DESKTOP_TOKEN
# 网桥密钥只有 FLUX_DESKTOP_BRIDGE_KEY。
# FLUX_DESKTOP_HOST=
# FLUX_DESKTOP_GATEWAY_TOKEN=
# FLUX_DESKTOP_BRIDGE=
# FLUX_DESKTOP_BRIDGE_KEY=
# 票据签名密钥；留空时会话仍可用，但 ticket 为 null。配置后即使没有长期令牌，
# GET /api/v1/desktop 也会返回 configured=true（客户端改走会话接口）。
# FLUX_DESKTOP_TICKET_SECRET=
# 票据有效期（秒）。
FLUX_DESKTOP_TICKET_TTL_SECONDS=300
# true  = 会话 / 入口参数下发长期 gateway_token / bridge_key；
# false = 只下发短期票据（GET /api/v1/desktop 里的长期凭据一并置为 null）。
FLUX_DESKTOP_SEND_GATEWAY_TOKEN=true
# 公开的 desktop.json：服务端代读隧道地址；留空 = 不读，直接用环境变量兜底。
FLUX_DESKTOP_CONFIG_URL=https://flux.qiuli55.top/fluxbot-mobile/desktop.json
# desktop.json 读不到时的兜底地址（通常留空，由服务端自动发现）。
# FLUX_DESKTOP_GATEWAY=
# FLUX_DESKTOP_BRIDGE_URL=
# FLUX_DESKTOP_TOKEN=

# --- 数据库 ---
# 默认 SQLite 落 /data/flux.db，个人 NAS 足够；要多机共享再换 Postgres。
# FLUX_DATABASE_URL=postgresql+asyncpg://flux:password@postgres:5432/flux

# --- 模型 ---
# 用哪家模型由 Bot 自己的配置决定，这里只放可复用的密钥。
FLUX_DEEPSEEK_API_KEY=
# FLUX_OPENAI_API_KEY=
# FLUX_ANTHROPIC_API_KEY=

# --- 中国区模型供应商（2026-11-12 接入）---
# 默认端点与默认模型已内置（见 server/flux/core/model_gateway/providers/official_models.py），
# 通常只填 API Key 即可。需要换地域 / 工作区域名或模型时，再覆盖对应的
# FLUX_<PROVIDER>_BASE_URL / FLUX_<PROVIDER>_MODEL。
# Qwen / DashScope（阿里云百炼）；新加坡地域：
#   FLUX_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# FLUX_QWEN_API_KEY=
# FLUX_QWEN_MODEL=qwen3.8-flash
# 智谱 GLM；Coding 套餐端点（/api/coding/paas/v4）不能当默认值。
# FLUX_ZHIPU_API_KEY=
# FLUX_ZHIPU_MODEL=glm-5.3
# Kimi / Moonshot
# FLUX_KIMI_API_KEY=
# FLUX_KIMI_MODEL=kimi-k3.1-pro
# 豆包 / 火山方舟；模型也可填账号内的推理接入点 ID（ep-...）。
# FLUX_DOUBAO_API_KEY=
# FLUX_DOUBAO_MODEL=doubao-seed-2-1-pro-260915

# --- Bot 调度 ---
# 开启后按 bots.next_run_at 自动开工，关掉仍可手动触发。
FLUX_BOT_SCHEDULER_ENABLED=true
FLUX_BOT_SCHEDULER_INTERVAL_SECONDS=30

# --- 外部例程触发（Webhook）---
# 通用入口 POST /api/v1/hooks/routines，校验请求头 X-Flux-Signature: sha256=<hex>（对原始请求体 HMAC-SHA256）。
# GitHub 入口 POST /api/v1/hooks/github，按官方文档校验 X-Hub-Signature-256。
# 留空 = fail-closed，拒绝所有入站请求。不要把密钥提交进仓库。
# FLUX_ROUTINE_WEBHOOK_SECRET=
# FLUX_GITHUB_WEBHOOK_SECRET=

# --- Email 入站触发（IMAP 轮询）---
# 定期只读已安装 email 连接器的邮件头，发现新邮件后发布 email.received。
# 首次轮询只建立水位线，不补发安装前的历史邮件；每轮只读邮件头，不自动回复。
# 轮询间隔小于 15 秒会被抬到 15 秒；设为 0 或负数等价于关闭轮询。
# FLUX_EMAIL_TRIGGER_ENABLED=true
# FLUX_EMAIL_TRIGGER_INTERVAL_SECONDS=60
# FLUX_EMAIL_TRIGGER_MAILBOX=INBOX
# FLUX_EMAIL_TRIGGER_LIMIT=20

# Bot 的 cron 表达式与每日 token 预算都按这个 IANA 时区解释（默认 UTC）。
# 例：Asia/Shanghai 下 `0 9 * * *` 是本地 09:00 开工，
# 每日预算也在本地零点重置（而不是 UTC 零点）。不设置时会回退到标准 TZ。
FLUX_TIMEZONE=Asia/Shanghai

# --- 飞书频道（Bot 入站 + 受审批出站）---
# 与 Supervisor 的飞书接入相互独立。回调地址：POST /api/v1/channels/feishu
# verification token 必填：未配置时拒绝一切回调（fail-closed）。
# FLUX_FEISHU_BOT_ID 是这条频道归属的 Flux Bot UUID，消息事件必须能定位到 Bot。
# 配置 Encrypt Key 后，回调必须带合法签名，密文按 AES-256-CBC 解密。
# FLUX_FEISHU_APP_ID=
# FLUX_FEISHU_APP_SECRET=
# FLUX_FEISHU_VERIFICATION_TOKEN=
# FLUX_FEISHU_ENCRYPT_KEY=
# FLUX_FEISHU_BOT_ID=
# 私有化部署可改 API 基址（默认官方）。
# FLUX_FEISHU_API_BASE=https://open.feishu.cn
# 红线：任何出站文本都要先在对话里点「允许」，拒绝 / 超时不会发送。

# --- 钉钉频道（HTTP 事件订阅入站 + 受审批出站）---
# 回调地址：POST /api/v1/channels/dingtalk（官方 HTTP 推送，暂不支持 Stream 长连接）。
# token / EncodingAESKey / AppKey 必填：未配置时拒绝一切回调（fail-closed）。
# 应用级事件订阅的 ownerKey 就是 AppKey；EncodingAESKey 必须是 43 位。
# FLUX_DINGTALK_BOT_ID 是这条频道归属的 Flux Bot UUID，消息事件必须能定位到 Bot。
# 红线：任何出站文本都要先在对话里点「允许」，拒绝 / 超时不会发送。
# FLUX_DINGTALK_APP_KEY=
# FLUX_DINGTALK_APP_SECRET=
# FLUX_DINGTALK_TOKEN=
# FLUX_DINGTALK_AES_KEY=
# FLUX_DINGTALK_BOT_ID=
# 私有化部署可改 API 基址（默认官方）。
# FLUX_DINGTALK_API_BASE=https://api.dingtalk.com

# --- 企业微信频道（WeCom，Bot 入站 + 受审批出站）---
# 自建应用回调地址：GET /api/v1/channels/wecom（校验 URL）与 POST 同路径（接收消息）。
# token / EncodingAESKey 必填：未配置时拒绝一切回调（fail-closed）。
# FLUX_WECOM_BOT_ID 是这条频道归属的 Flux Bot UUID，消息事件必须能定位到 Bot。
# corp_id / agent_id / secret 用于取 access_token 并发送应用消息；未配置时草稿保留但不发送。
# FLUX_WECOM_CORP_ID=
# FLUX_WECOM_AGENT_ID=
# FLUX_WECOM_SECRET=
# FLUX_WECOM_TOKEN=
# FLUX_WECOM_ENCODING_AES_KEY=
# FLUX_WECOM_BOT_ID=
# 私有化部署可改 API 基址（默认官方）。
# FLUX_WECOM_API_BASE=https://qyapi.weixin.qq.com
# 红线：任何出站文本都要先在对话里点「允许」，拒绝 / 超时不会发送。

# --- 执行内核（Claude Code）---
# 所有 Bot（新老一致）都以 Claude Code 为底座执行任务，镜像内已装好 claude CLI。
# 使用第三方订阅套餐时：先在 OpenClaw 登录，再把网关地址填到 FLUX_ANTHROPIC_BASE_URL，
# Claude Code 会以 Anthropic 协议调用该网关。直连官方则留空 base_url、只填 API Key。
# FLUX_ANTHROPIC_API_KEY=
# FLUX_ANTHROPIC_BASE_URL=https://your-openclaw-gateway.example.com
# FLUX_ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude Code 的鉴权头：API Key 走 X-Api-Key，Auth Token 走 Authorization: Bearer。
# 两者互斥（同时下发会触发 CLI 鉴权冲突告警），Flux 只会注入其中一个。
#   auto       = 官方域名（或留空 base_url）用 API Key，其它网关用 Auth Token
#   api_key    = 强制 API Key
#   auth_token = 强制 Auth Token（自建 LLM 网关需要 Bearer 时用）
# FLUX_ANTHROPIC_AUTH_MODE=auto
# Bot 节点启动时自动接入 Claude Code（默认关闭）。设为 true 后，若容器内能在 PATH
# 找到 claude CLI，启动阶段会把 claude-code 的 installation 自动推进到 READY，
# 等价于手动执行 `flux agents connect claude-code`；找不到 CLI 只打印 WARNING，
# 不影响服务启动。首次部署也可以不开启，改为按 README「接入 Claude Code」手动执行。
# FLUX_AUTO_CONNECT_CLAUDE_CODE=false
# 运行期目录（隔离配置 / 会话 / Bot 工作区）：容器里默认 /data/runtime-home
# FLUX_RUNTIME_HOME=/data/runtime-home
# 注入给 Agent 的 MCP 端点（streamable-http）。端口必须与 FLUX_BOT_PORT /
# entrypoint 实际监听端口一致；不设置时 Bot 节点自动推导为
# http://127.0.0.1:${FLUX_BOT_PORT:-8600}/mcp。仅隔离实例或反向代理时才需要覆盖。
# FLUX_MCP_URL=http://127.0.0.1:8600/mcp
# 额外注入 Claude Code 内核的 MCP server（JSON 对象，形状同 Claude Code 的 mcpServers）。
# 只接受 http / sse 型远程 server；stdio / command 型会被拒绝（避免在容器内拉起任意进程）。
# server 名须匹配 [A-Za-z0-9_-]{1,64}，其中 "flux" 为 Flux 保留名。
# headers 可放鉴权令牌，但不要把真实密钥提交进仓库；日志只记 server 名，不打印 headers。
# 浏览器自动化的完整用法见 docs/browser-agent.md。示例（经 docker 网络访问 Playwright MCP）：
# FLUX_CLAUDE_EXTRA_MCP_SERVERS={"browser": {"type": "http", "url": "http://playwright-mcp:8931/mcp"}}
# Playwright MCP sidecar 的浏览器 profile id（docker-compose.browser.yml 用 compose
# 插值拼出 --user-data-dir /home/node/profiles/<id>）。默认 default；多用户部署时
# 设为各自的账号 / 用户 id，不要共享同一个 profile。浏览器登录态持久化在
# playwright-home 命名卷里，重置方式见 docs/browser-agent.md。
# FLUX_BROWSER_PROFILE_ID=default

# --- 密钥库主密钥 ---
# 强烈建议显式设置：加密 API Key / GitHub Token 的主密钥。留空时首次启动会自动
# 生成到 $HOME/.flux/key-vault.key（容器里即 /data/home/.flux/key-vault.key）。
# 这是任意非空字符串（原始口令，不是 Fernet base64 密钥）；丢失后已存密钥无法解密。
# 生成一个随机值：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 设置后请单独备份；不设置则务必备份上面那个 key-vault.key 文件。
# FLUX_KEY_VAULT_SECRET=

# --- 工作区 ---
# Bot 读写文件的范围，建议指向挂载进来的项目目录，不要给整个 NAS 根。
FLUX_WORKSPACE_ROOT=/data/workspace

# --- 日志 ---
FLUX_LOG_LEVEL=INFO
